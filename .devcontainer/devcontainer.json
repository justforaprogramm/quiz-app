{
  "name": "quizapp Development",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.terminal.activateEnvironment": true
      }
    }
  },
  
  // Wir lassen das venv erst einmal weg, um zu sehen, ob der Container überhaupt startet
  "remoteUser": "vscode"
}