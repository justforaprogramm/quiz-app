{
  "name": "quiz-app Development",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  
  // Installiert Node für Cloudflare und richtet das venv ein
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },
  
  "remoteUser": "vscode"
}
